# HarnessAmp local/dev environment template.
# Copy to .env.local for local Vite/API development.

# Required for signed HarnessAmp session cookies.
SESSION_SECRET=replace-with-a-long-random-string

# Required for GitHub OAuth.
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Required in production/preview so OAuth callback URLs are stable.
# Local dev can omit this if using http://127.0.0.1:4173.
APP_BASE_URL=http://127.0.0.1:4173

# Optional: enables instant local auth without GitHub OAuth.
# Do not enable in production.
HARNESSAMP_DEV_AUTH=0

# Optional: durable Vercel KV/Postgres style settings used by server APIs.
KV_REST_API_URL=
KV_REST_API_TOKEN=
DATABASE_URL=
