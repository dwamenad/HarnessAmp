{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessAmp Run Artifacts",
  "type": "object",
  "required": ["version", "artifacts"],
  "properties": {
    "version": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "runId", "type", "title", "redacted"],
        "properties": {
          "id": { "type": "string" },
          "runId": { "type": "string" },
          "taskId": { "type": "string" },
          "mutationId": { "type": ["string", "null"] },
          "type": {
            "type": "string",
            "enum": [
              "runner_artifact",
              "terminal_command",
              "terminal_output",
              "stdout",
              "stderr",
              "file_diff",
              "sandbox_event",
              "approval_event"
            ]
          },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "contentType": { "type": ["string", "null"] },
          "uri": { "type": ["string", "null"] },
          "metadata": { "type": "object" },
          "redacted": { "type": "boolean" },
          "createdAt": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
