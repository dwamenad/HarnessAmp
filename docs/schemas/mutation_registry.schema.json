{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessAmp Mutation Registry",
  "type": "object",
  "required": ["version", "packs", "mutations"],
  "properties": {
    "version": {
      "type": "string"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mutations"],
        "properties": {
          "id": { "type": "string" },
          "mutations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mutationId",
          "mutationFamily",
          "pack",
          "surface",
          "target",
          "trustBoundary",
          "operation",
          "severity",
          "mutationTemplate",
          "expectedFailure",
          "robustBehavior",
          "diagnosticSignal",
          "recommendedControl",
          "version",
          "deterministicSeed"
        ],
        "properties": {
          "mutationId": { "type": "string" },
          "mutationFamily": { "type": "string" },
          "pack": { "type": "string" },
          "surface": { "type": "string" },
          "target": { "type": "string" },
          "trustBoundary": { "type": "string" },
          "operation": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "mutationTemplate": { "type": "string" },
          "parameterSlots": { "type": "array", "items": { "type": "string" } },
          "expectedFailure": { "type": "string" },
          "robustBehavior": { "type": "string" },
          "diagnosticSignal": { "type": "string" },
          "recommendedControl": { "type": "string" },
          "scoringTags": { "type": "array", "items": { "type": "string" } },
          "version": { "type": "string" },
          "deterministicSeed": { "type": "integer" },
          "defensiveOnly": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
