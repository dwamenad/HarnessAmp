{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessAmp Failure Corpus",
  "type": "object",
  "required": ["version", "project", "summary", "entries"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["entryCount", "hiddenFailureCount", "uniqueSurfaceCount", "uniqueFailureTypeCount"],
      "properties": {
        "entryCount": { "type": "integer", "minimum": 0 },
        "hiddenFailureCount": { "type": "integer", "minimum": 0 },
        "uniqueSurfaceCount": { "type": "integer", "minimum": 0 },
        "uniqueFailureTypeCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "variantId", "surface", "tier", "failureType"],
        "properties": {
          "id": { "type": "string" },
          "capturedAt": { "type": "string" },
          "project": { "type": "string" },
          "variantId": { "type": "string" },
          "familyId": { "type": "string" },
          "familyLabel": { "type": "string" },
          "surface": { "type": "string" },
          "tier": { "type": "string", "enum": ["visible", "holdout"] },
          "title": { "type": "string" },
          "failureType": { "type": "string" },
          "observedBehavior": { "type": "string" },
          "expectedBehavior": { "type": "string" },
          "fixCandidates": { "type": "array", "items": { "type": "string" } },
          "generalized": { "type": ["boolean", "null"] },
          "evidence": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
