{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessAmp Benchmark Pack",
  "type": "object",
  "required": ["project", "intent", "contract", "benchmark", "wrapper"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "format": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "intent": {
      "type": "object",
      "required": ["mission"],
      "properties": {
        "mission": { "type": "string", "minLength": 1 },
        "reviewStatus": { "type": "string" },
        "successSignals": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "contract": {
      "type": "object",
      "properties": {
        "reviewStatus": { "type": "string" },
        "global": {
          "type": "object",
          "properties": {
            "must": { "type": "array", "items": { "type": "string" } },
            "mustNot": { "type": "array", "items": { "type": "string" } },
            "finalResponders": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "role"],
            "properties": {
              "id": { "type": "string" },
              "role": { "type": "string" },
              "responsibilities": { "type": "array", "items": { "type": "string" } },
              "must": { "type": "array", "items": { "type": "string" } },
              "mustNot": { "type": "array", "items": { "type": "string" } },
              "allowedTools": { "type": "array", "items": { "type": "string" } },
              "finalResponder": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "handoffs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "count": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "benchmark": {
      "type": "object",
      "required": ["cases"],
      "properties": {
        "reviewStatus": { "type": "string" },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "input": { "type": "string" },
              "allowedAgents": { "type": "array", "items": { "type": "string" } },
              "expectedMilestones": { "type": "array", "items": { "type": "string" } },
              "assertions": { "type": "array", "items": { "type": "string" } },
              "forbiddenActions": { "type": "array", "items": { "type": "string" } },
              "passRules": { "type": "array", "items": { "type": "string" } },
              "rubricFields": { "type": "array", "items": { "type": "string" } },
              "seed": { "type": "integer" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "wrapper": {
      "type": "object",
      "required": ["agentName", "systemPrompt", "tools", "runtime"],
      "properties": {
        "agentName": { "type": "string" },
        "domain": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "developerPrompt": { "type": "string" },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "schema"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "schema": { "type": "object" }
            },
            "additionalProperties": true
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "objective"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "objective": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "runtime": {
          "type": "object",
          "required": ["responseFormat", "retryPolicy", "toolApproval", "stopSequences", "messageEnvelope"],
          "properties": {
            "responseFormat": { "type": "string" },
            "retryPolicy": {
              "type": "object",
              "required": ["maxAttempts", "backoffMs", "jitterMs"],
              "properties": {
                "maxAttempts": { "type": "integer", "minimum": 1 },
                "backoffMs": { "type": "integer", "minimum": 0 },
                "jitterMs": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            },
            "toolApproval": { "type": "boolean" },
            "stopSequences": { "type": "array", "items": { "type": "string" } },
            "messageEnvelope": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "mutationPolicy": {
      "type": "object",
      "properties": {
        "intensity": { "type": "integer", "minimum": 1, "maximum": 4 },
        "semanticGuardrails": { "type": "array", "items": { "type": "string" } },
        "visibleFamilies": { "type": "array", "items": { "type": "string" } },
        "holdoutFamilies": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "scorers": {
      "type": "array",
      "items": { "type": "object" }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "links": { "type": "array", "items": { "type": "object" } },
        "sources": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "observations": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true
}
